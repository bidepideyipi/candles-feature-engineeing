# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=technical_analysis
MONGODB_CANDLESTICKS_COLLECTION=candlesticks
MONGODB_FEATURES_COLLECTION=features
MONGODB_NORMALIZER_COLLECTION=normalizer
MONGODB_CONFIG_COLLECTION=config

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# regime 当前值 / 滑动窗口 / 反转告警 stream
REDIS_REGIME_STREAM=regime_signals
REDIS_REGIME_WINDOW_HOURS=48
REDIS_REGIME_REVERSAL_CONFIRM=2
REDIS_REGIME_MIN_CONFIDENCE=0.65

# OKEx API Configuration
OKEX_API_BASE_URL=https://www.okx.com

# Model Configuration
MODEL_SAVE_PATH=models/xgboost_model.json
FEATURE_WINDOW_SIZE=300
# Forward regime label horizon for /regime/1-label only (1H bars).
# /regime/2-train reads horizon from labeled features (regime_horizon_hours).
# Mongo field name stays regime_48h.
REGIME_HORIZON_HOURS=48
# XGBoost imbalance: balanced | none (for continue/change)
REGIME_CLASS_WEIGHT=balanced
# P(change) decision threshold
REGIME_CHANGE_THRESHOLD=0.5
# Confirm a transition only after N consecutive different-regime 1H rows
REGIME_CHANGE_CONFIRM_BARS=2
# Purged walk-forward validation folds
REGIME_CV_SPLITS=3
# Minimum holdout precision required before model alerts are enabled
REGIME_MIN_CHANGE_PRECISION=0.5
# Optional fixed holdout start timestamp (ms) for fair horizon comparisons; 0=ratio
REGIME_HOLDOUT_START_TS=0

# Environment Mode
PRODUCTION_MODE=false

# Scheduled Task Configuration
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL=12
SCHEDULE_RECIPIENT=284160266@qq.com
SCHEDULE_DATA_SOURCE=mongodb
